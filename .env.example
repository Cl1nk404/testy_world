# Настройки GigaChat 3 Ultra (Freemium для физических лиц)
GIGACHAT_CREDENTIALS=
GIGACHAT_MODEL=GigaChat-3-Ultra
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_VERIFY_SSL_CERTS=true

# Канал публикации: telegram (старый способ) или dzen (браузерный черновик)
PUBLISHER=telegram

# Для режима Dzen: Chrome запускается через scripts/start_chrome.bat.
# Войди в аккаунт вручную в отдельном окне Chrome.
DZEN_CDP_URL=http://127.0.0.1:9222
DZEN_EDITOR_URL=https://dzen.ru/profile/editor/create

# Публичный Telegram-канал, например @my_channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=

# Часовой пояс и время ежедневного запуска
TIMEZONE=Europe/Moscow
POST_HOUR=9
POST_MINUTE=0

# ВАЖНО: сначала оставьте true и проверьте генерацию без публикации.
DRY_RUN=true

# Генерация изображений блюда через Cloudflare Workers AI (FLUX.1 Schnell)
ENABLE_IMAGE=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
IMAGE_OUTPUT_DIR=output/images

DATABASE_PATH=data/recipes.db
OUTPUT_DIR=output
LOG_DIR=logs
