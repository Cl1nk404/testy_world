# Server security: generate a unique random value (at least 32 bytes); never commit real secrets.
APP_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=10080
DATABASE_URL=sqlite:///./data/app.db

# GigaChat
# Use the Base64 Authorization key from the GigaChat API cabinet, NOT Client Secret.
GIGACHAT_CREDENTIALS=
GIGACHAT_MODEL=GigaChat-3-Ultra
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_VERIFY_SSL_CERTS=true
# Optional path to the trusted root CA PEM/CRT file required by GigaChat (see README).
GIGACHAT_CA_BUNDLE_FILE=

# One Telegram bot owned by the service operator. Users add their own destinations in the web UI.
TELEGRAM_BOT_TOKEN=

# Optional image generation (Cloudflare Workers AI). The user's checkbox controls whether it is called.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# The old single-user CLI variables below are retained only for the legacy command.
TIMEZONE=Europe/Riga
POST_HOUR=9
POST_MINUTE=0
DRY_RUN=true
ENABLE_IMAGE=false
IMAGE_OUTPUT_DIR=output/images
DATABASE_PATH=data/recipes.db
OUTPUT_DIR=output
LOG_DIR=logs
