# Создайте копию этого файла с именем .env и заполните значения.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Публичный Telegram-канал, например @my_channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=

# Часовой пояс и время ежедневного запуска
TIMEZONE=Europe/Moscow
POST_HOUR=9
POST_MINUTE=0

# ВАЖНО: сначала оставьте true и проверьте генерацию без публикации.
DRY_RUN=true

# Генерация изображений в этой версии выключена, чтобы не возникли расходы.
ENABLE_IMAGE=false

DATABASE_PATH=data/recipes.db
OUTPUT_DIR=output
LOG_DIR=logs
